# Copy to .env and fill in. Never commit .env; this file must only ever hold placeholders.

HF_TOKEN=
HF_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
HF_NER_MODEL=dslim/bert-base-NER
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional: OpenAI-compatible chat server (e.g. Ollama) for relations/answers; HF_LLM_MODEL is then its model name.
LLM_BASE_URL=
# Optional: run embeddings and NER locally (any non-empty value enables it).
LOCAL_MODELS=

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=graph_rag_chunks

# Optional Langfuse tracing. Leave the keys blank to disable it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Fraction of queries traced (0.0-1.0).
LANGFUSE_SAMPLE_RATE=1.0
# metadata (default): IDs, scores, counts, timings, model, token usage only.
# full: also question, prompt, retrieved context and answer (redacted for keys/emails, truncated).
# Anything other than "full" means metadata.
TRACE_CONTENT=metadata

# Citation check: enforce (default) withdraws answers whose citations don't support them;
# annotate keeps them, flagged. Anything other than "annotate" means enforce.
CITATION_POLICY=enforce

# Optional RAGAS evaluator. Point OPENAI_BASE_URL at an OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:20128
RAGAS_LLM_MODEL=
RAGAS_EMBEDDING_MODEL=
